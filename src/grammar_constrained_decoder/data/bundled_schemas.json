{
  "version": 1,
  "schemas": [
    {"id": "user_profile", "split": "train", "description": "a user profile with id, name, email, age and active flag", "schema": {"type": "object", "properties": {"id": {"type": "integer", "minimum": 1, "maximum": 99999}, "name": {"type": "string", "minLength": 1, "maxLength": 32}, "email": {"type": "string", "maxLength": 48, "pattern": "^[a-z0-9._]+@[a-z]+\\.(com|org|net)$"}, "age": {"type": "integer", "minimum": 13, "maximum": 120}, "active": {"type": "boolean"}}, "required": ["id", "name", "email"], "additionalProperties": false}},
    {"id": "product", "split": "train", "description": "a product with sku, title, price, currency, stock flag and tags", "schema": {"type": "object", "properties": {"sku": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{4}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 48}, "price": {"type": "number", "minimum": 0, "maximum": 10000}, "currency": {"enum": ["USD", "EUR", "GBP"]}, "in_stock": {"type": "boolean"}, "tags": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 12}, "maxItems": 4}}, "required": ["sku", "title", "price", "currency"], "additionalProperties": false}},
    {"id": "weather_reading", "split": "train", "description": "a weather reading with station, temperature, humidity, condition and wind", "schema": {"type": "object", "properties": {"station": {"type": "string", "pattern": "^[A-Z]{4}[0-9]{2}$"}, "temperature_c": {"type": "number", "minimum": -60, "maximum": 60}, "humidity": {"type": "integer", "minimum": 0, "maximum": 100}, "condition": {"enum": ["sunny", "cloudy", "rain", "snow", "fog"]}, "wind_kph": {"type": "number", "minimum": 0, "maximum": 300}}, "required": ["station", "temperature_c", "condition"], "additionalProperties": false}},
    {"id": "log_event", "split": "train", "description": "a log event with level, message, status code and retry flag", "schema": {"type": "object", "properties": {"level": {"enum": ["debug", "info", "warning", "error"]}, "message": {"type": "string", "minLength": 1, "maxLength": 80}, "code": {"type": "integer", "minimum": 100, "maximum": 599}, "retry": {"type": "boolean"}}, "required": ["level", "message"], "additionalProperties": false}},
    {"id": "address", "split": "train", "description": "a postal address with street, city, postal code and country", "schema": {"type": "object", "properties": {"street": {"type": "string", "minLength": 1, "maxLength": 40}, "city": {"type": "string", "minLength": 1, "maxLength": 24}, "postal_code": {"type": "string", "pattern": "^[0-9]{5}$"}, "country": {"enum": ["DE", "FR", "IT", "ES", "NL", "PL"]}}, "required": ["street", "city", "postal_code", "country"], "additionalProperties": false}},
    {"id": "order", "split": "train", "description": "an order with id, customer, line items and total", "schema": {"type": "object", "properties": {"order_id": {"type": "integer", "minimum": 1, "maximum": 9999999}, "customer": {"type": "object", "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 32}, "email": {"type": "string", "maxLength": 48, "pattern": "^[a-z0-9._]+@[a-z]+\\.(com|org|net)$"}}, "required": ["name"], "additionalProperties": false}, "items": {"type": "array", "items": {"type": "object", "properties": {"sku": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{4}$"}, "quantity": {"type": "integer", "minimum": 1, "maximum": 20}}, "required": ["sku", "quantity"], "additionalProperties": false}, "minItems": 1, "maxItems": 5}, "total": {"type": "number", "minimum": 0, "maximum": 100000}}, "required": ["order_id", "customer", "items", "total"], "additionalProperties": false}},
    {"id": "calendar_event", "split": "train", "description": "a calendar event with title, start time, duration, attendees and location", "schema": {"type": "object", "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 40}, "start": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]$"}, "duration_minutes": {"type": "integer", "minimum": 5, "maximum": 480}, "attendees": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 24}, "maxItems": 6}, "location": {"anyOf": [{"type": "string", "maxLength": 32}, {"type": "null"}]}}, "required": ["title", "start", "duration_minutes"], "additionalProperties": false}},
    {"id": "book", "split": "train", "description": "a book with isbn, title, authors, year and genre", "schema": {"type": "object", "properties": {"isbn": {"type": "string", "pattern": "^97[89][0-9]{10}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 48}, "authors": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 32}, "minItems": 1, "maxItems": 3}, "year": {"type": "integer", "minimum": 1450, "maximum": 2030}, "genre": {"enum": ["fiction", "science", "history", "poetry", "travel"]}}, "required": ["isbn", "title", "authors", "year"], "additionalProperties": false}},
    {"id": "sensor_batch", "split": "train", "description": "a batch of sensor readings with device id, values and unit", "schema": {"type": "object", "properties": {"device_id": {"type": "string", "pattern": "^dev-[0-9a-f]{6}$"}, "readings": {"type": "array", "items": {"type": "number", "minimum": -1000, "maximum": 1000}, "minItems": 1, "maxItems": 8}, "unit": {"enum": ["celsius", "volt", "ampere", "pascal"]}}, "required": ["device_id", "readings", "unit"], "additionalProperties": false}},
    {"id": "todo_item", "split": "train", "description": "a todo item with id, text, done flag, priority and due date", "schema": {"type": "object", "properties": {"id": {"type": "integer", "minimum": 1, "maximum": 100000}, "text": {"type": "string", "minLength": 1, "maxLength": 60}, "done": {"type": "boolean"}, "priority": {"enum": ["low", "medium", "high"]}, "due": {"anyOf": [{"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"}, {"type": "null"}]}}, "required": ["id", "text", "done"], "additionalProperties": false}},
    {"id": "http_request", "split": "train", "description": "an http request log line with method, path, status and latency", "schema": {"type": "object", "properties": {"method": {"enum": ["GET", "POST", "PUT", "DELETE"]}, "path": {"type": "string", "maxLength": 40, "pattern": "^/[a-z0-9/_-]*$"}, "status": {"type": "integer", "minimum": 100, "maximum": 599}, "latency_ms": {"type": "number", "minimum": 0, "maximum": 60000}}, "required": ["method", "path", "status"], "additionalProperties": false}},
    {"id": "recipe", "split": "train", "description": "a recipe with name, servings, ingredients and vegetarian flag", "schema": {"type": "object", "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 40}, "servings": {"type": "integer", "minimum": 1, "maximum": 12}, "ingredients": {"type": "array", "items": {"type": "object", "properties": {"item": {"type": "string", "minLength": 1, "maxLength": 24}, "grams": {"type": "number", "minimum": 0, "maximum": 5000}}, "required": ["item", "grams"], "additionalProperties": false}, "minItems": 1, "maxItems": 6}, "vegetarian": {"type": "boolean"}}, "required": ["name", "servings", "ingredients"], "additionalProperties": false}},
    {"id": "flight", "split": "train", "description": "a flight with number, origin, destination, departure and seats left", "schema": {"type": "object", "properties": {"flight_no": {"type": "string", "pattern": "^[A-Z]{2}[0-9]{2,4}$"}, "from": {"type": "string", "pattern": "^[A-Z]{3}$"}, "to": {"type": "string", "pattern": "^[A-Z]{3}$"}, "departure": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}, "seats_left": {"type": "integer", "minimum": 0, "maximum": 400}}, "required": ["flight_no", "from", "to", "departure"], "additionalProperties": false}},
    {"id": "employee", "split": "train", "description": "an employee record with id, name, department, salary and manager", "schema": {"type": "object", "properties": {"employee_id": {"type": "string", "pattern": "^E[0-9]{5}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 32}, "department": {"enum": ["engineering", "sales", "finance", "support", "research"]}, "salary": {"type": "integer", "minimum": 20000, "maximum": 400000}, "manager": {"anyOf": [{"type": "string", "pattern": "^E[0-9]{5}$"}, {"type": "null"}]}}, "required": ["employee_id", "name", "department"], "additionalProperties": false}},
    {"id": "movie_rating", "split": "train", "description": "a movie rating with title, rating, votes and genres", "schema": {"type": "object", "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 48}, "rating": {"type": "number", "minimum": 0, "maximum": 10}, "votes": {"type": "integer", "minimum": 0, "maximum": 5000000}, "genres": {"type": "array", "items": {"enum": ["drama", "comedy", "action", "horror", "documentary"]}, "maxItems": 3}}, "required": ["title", "rating"], "additionalProperties": false}},
    {"id": "bank_transfer", "split": "train", "description": "a bank transfer with amount, currency, reference and instant flag", "schema": {"type": "object", "properties": {"amount": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}, "currency": {"enum": ["USD", "EUR", "GBP", "CHF"]}, "reference": {"type": "string", "maxLength": 35}, "instant": {"type": "boolean"}}, "required": ["amount", "currency"], "additionalProperties": false}},
    {"id": "chat_message", "split": "train", "description": "a chat message with user, text, reactions and edited flag", "schema": {"type": "object", "properties": {"user": {"type": "string", "minLength": 1, "maxLength": 24}, "text": {"type": "string", "minLength": 1, "maxLength": 120}, "reactions": {"type": "array", "items": {"enum": ["like", "love", "laugh", "sad"]}, "maxItems": 5}, "edited": {"type": "boolean"}}, "required": ["user", "text"], "additionalProperties": false}},
    {"id": "file_metadata", "split": "train", "description": "file metadata with path, size, mime type and checksum", "schema": {"type": "object", "properties": {"path": {"type": "string", "maxLength": 60, "pattern": "^/[a-z0-9/._-]+$"}, "size_bytes": {"type": "integer", "minimum": 0}, "mime": {"enum": ["text/plain", "image/png", "application/json", "application/pdf"]}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}, "required": ["path", "size_bytes", "mime"], "additionalProperties": false}},
    {"id": "invoice", "split": "eval", "description": "an invoice with number, customer email, lines, paid flag and currency", "schema": {"type": "object", "properties": {"invoice_no": {"type": "string", "pattern": "^INV-[0-9]{6}$"}, "customer_email": {"type": "string", "maxLength": 48, "pattern": "^[a-z0-9._]+@[a-z]+\\.(com|org|net)$"}, "lines": {"type": "array", "items": {"type": "object", "properties": {"description": {"type": "string", "minLength": 1, "maxLength": 40}, "amount": {"type": "number", "minimum": 0, "maximum": 100000}}, "required": ["description", "amount"], "additionalProperties": false}, "minItems": 1, "maxItems": 4}, "paid": {"type": "boolean"}, "currency": {"enum": ["USD", "EUR", "GBP"]}}, "required": ["invoice_no", "lines", "paid"], "additionalProperties": false}},
    {"id": "vital_signs", "split": "eval", "description": "synthetic vital signs with heart rate, blood pressure, temperature and notes", "schema": {"type": "object", "properties": {"heart_rate": {"type": "integer", "minimum": 30, "maximum": 220}, "systolic": {"type": "integer", "minimum": 70, "maximum": 250}, "diastolic": {"type": "integer", "minimum": 40, "maximum": 150}, "temperature_c": {"type": "number", "minimum": 34, "maximum": 43}, "notes": {"anyOf": [{"type": "string", "maxLength": 60}, {"type": "null"}]}}, "required": ["heart_rate", "systolic", "diastolic"], "additionalProperties": false}},
    {"id": "shipment", "split": "eval", "description": "a shipment with tracking code, carrier, weight, destination and status", "schema": {"type": "object", "properties": {"tracking": {"type": "string", "pattern": "^[A-Z0-9]{10}$"}, "carrier": {"enum": ["dhl", "ups", "fedex", "post"]}, "weight_kg": {"type": "number", "minimum": 0, "maximum": 1000}, "destination": {"type": "object", "properties": {"city": {"type": "string", "minLength": 1, "maxLength": 24}, "country": {"enum": ["DE", "FR", "IT", "ES", "NL", "PL"]}}, "required": ["city", "country"], "additionalProperties": false}, "status": {"enum": ["created", "in_transit", "delivered", "returned"]}}, "required": ["tracking", "carrier", "destination", "status"], "additionalProperties": false}},
    {"id": "job_posting", "split": "eval", "description": "a job posting with title, company, remote flag, salary range and skills", "schema": {"type": "object", "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 40}, "company": {"type": "string", "minLength": 1, "maxLength": 32}, "remote": {"type": "boolean"}, "salary_min": {"type": "integer", "minimum": 10000, "maximum": 500000}, "salary_max": {"type": "integer", "minimum": 10000, "maximum": 900000}, "skills": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 16}, "maxItems": 5}}, "required": ["title", "company", "remote"], "additionalProperties": false}},
    {"id": "category_tree", "split": "eval", "description": "a category tree with a label and nested children", "schema": {"type": "object", "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 12}, "children": {"type": "array", "items": {"$ref": "#"}, "maxItems": 3}}, "required": ["label"], "additionalProperties": false}},
    {"id": "feature_flag", "split": "eval", "description": "a feature flag with name, enabled flag, rollout percent and environments", "schema": {"type": "object", "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,30}$"}, "enabled": {"type": "boolean"}, "rollout_percent": {"type": "integer", "minimum": 0, "maximum": 100}, "environments": {"type": "array", "items": {"enum": ["dev", "staging", "prod"]}, "maxItems": 3}}, "required": ["name", "enabled"], "additionalProperties": false}},
    {"id": "game_score", "split": "eval", "description": "a game score with player, level, score and achievements", "schema": {"type": "object", "properties": {"player": {"type": "string", "minLength": 1, "maxLength": 24}, "level": {"type": "integer", "minimum": 1, "maximum": 99}, "score": {"type": "integer", "minimum": 0, "maximum": 10000000}, "achievements": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 20}, "maxItems": 4}}, "required": ["player", "level", "score"], "additionalProperties": false}},
    {"id": "air_quality", "split": "eval", "description": "an air quality report with city, pm25, index and category", "schema": {"type": "object", "properties": {"city": {"type": "string", "minLength": 1, "maxLength": 24}, "pm25": {"type": "number", "minimum": 0, "maximum": 999}, "aqi": {"type": "integer", "minimum": 0, "maximum": 500}, "category": {"enum": ["good", "moderate", "unhealthy", "hazardous"]}}, "required": ["city", "aqi", "category"], "additionalProperties": false}},
    {"id": "library_loan", "split": "eval", "description": "a library loan with isbn, member id, due date and renewals", "schema": {"type": "object", "properties": {"isbn": {"type": "string", "pattern": "^97[89][0-9]{10}$"}, "member_id": {"type": "string", "pattern": "^M[0-9]{6}$"}, "due_date": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"}, "renewals": {"type": "integer", "minimum": 0, "maximum": 3}}, "required": ["isbn", "member_id", "due_date"], "additionalProperties": false}},
    {"id": "support_ticket", "split": "eval", "description": "a support ticket with id, severity, summary, tags and assignee", "schema": {"type": "object", "properties": {"ticket_id": {"type": "integer", "minimum": 1, "maximum": 999999}, "severity": {"enum": ["sev1", "sev2", "sev3", "sev4"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 80}, "tags": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 12}, "maxItems": 4}, "assignee": {"anyOf": [{"type": "string", "maxLength": 24}, {"type": "null"}]}}, "required": ["ticket_id", "severity", "summary"], "additionalProperties": false}},
    {"id": "hotel_booking", "split": "eval", "description": "a hotel booking with hotel, nights, guests, breakfast, room type and price", "schema": {"type": "object", "properties": {"hotel": {"type": "string", "minLength": 1, "maxLength": 32}, "nights": {"type": "integer", "minimum": 1, "maximum": 30}, "guests": {"type": "integer", "minimum": 1, "maximum": 6}, "breakfast": {"type": "boolean"}, "room_type": {"enum": ["single", "double", "suite"]}, "price_per_night": {"type": "number", "minimum": 0, "maximum": 5000}}, "required": ["hotel", "nights", "guests", "room_type"], "additionalProperties": false}},
    {"id": "geo_point", "split": "eval", "description": "a geographic point with latitude, longitude, label and accuracy", "schema": {"type": "object", "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}, "label": {"type": "string", "maxLength": 30}, "accuracy_m": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 10000}, {"type": "null"}]}}, "required": ["lat", "lon"], "additionalProperties": false}}
  ]
}
