# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=grammar-constrained-decoder
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Operator API keys (for /metrics): comma-separated lowercase SHA-256 digests.
# Generate a key with: uv run grammar-constrained-decoder generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# JWT (HS256) for the generation API. At least 32 bytes; with no secret every token is refused.
# Mint a token with: uv run grammar-constrained-decoder issue-token --sub alice --scope generate
APP_JWT_SECRET=
APP_JWT_ISSUER=grammar-constrained-decoder
APP_JWT_AUDIENCE=gcd-api
APP_JWT_LEEWAY_SECONDS=30
APP_JWT_MAX_TTL_SECONDS=86400

# Generation limits.
APP_MAX_TOKENS_CAP=256
APP_MAX_PROMPT_CHARS=2000
APP_MAX_PROMPT_TOKENS=512
APP_MAX_INLINE_SCHEMA_BYTES=32768
APP_MAX_CONCURRENT_GENERATIONS=4
APP_MAX_CONCURRENT_PER_CLIENT=2

# Schema compiler limits.
APP_COMPILE_TIMEOUT_SECONDS=5
APP_COMPILE_MAX_DFA_STATES=20000
APP_COMPILE_MAX_DEPTH=6

# Storage: schema registry, audit log and index cache live under APP_DATA_DIR; the trained model
# registry (from `grammar-constrained-decoder train`) under APP_MODEL_DIR/registry.
APP_DATA_DIR=var
APP_MODEL_DIR=var/model/registry
